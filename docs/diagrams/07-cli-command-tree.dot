// IronBus CLI command tree (generated). Render: dot -Tpdf 07-cli-command-tree.dot -o 07-cli-command-tree.pdf
digraph cli_tree {
  rankdir=LR;
  labelloc="t"; fontsize=18; fontname="Helvetica";
  label="IronBus CLI command map (one binary = broker + CLI). Green=offline-capable on the data dir, blue=online, tan=offline-only";
  graph [bgcolor="white", ranksep=0.7, nodesep=0.18, splines=polyline];
  node [fontname="Helvetica", fontsize=10, shape=box, style="filled,rounded"];
  edge [color="#888888", arrowsize=0.6];
  root [label="ironbus", fillcolor="#33506b", fontcolor="white", color="#33506b"];
  n_serve [label="serve", fillcolor="#eef3fb", color="#33506b"];
  n_pub [label="pub", fillcolor="#eef3fb", color="#33506b"];
  n_sub [label="sub", fillcolor="#eef3fb", color="#33506b"];
  n_tap [label="tap", fillcolor="#eef3fb", color="#33506b"];
  n_wire [label="wire", fillcolor="#f0ead9", color="#9a8a1e"];
  n_bench [label="bench", fillcolor="#eef3fb", color="#33506b"];
  n_info [label="info", fillcolor="#e7f6ec", color="#2f7d4f"];
  n_consumer [label="consumer", fillcolor="#ffffff", color="#888888"];
  n_consumer_ls [label="ls", fillcolor="#e7f6ec", color="#2f7d4f"];
  n_consumer_info [label="info", fillcolor="#e7f6ec", color="#2f7d4f"];
  n_consumer_lag [label="lag", fillcolor="#e7f6ec", color="#2f7d4f"];
  n_consumer_reset [label="reset", fillcolor="#eef3fb", color="#33506b"];
  n_consumer_purge [label="purge", fillcolor="#eef3fb", color="#33506b"];
  n_consumer_pause [label="pause", fillcolor="#eef3fb", color="#33506b"];
  n_consumer_resume [label="resume", fillcolor="#eef3fb", color="#33506b"];
  n_peek [label="peek", fillcolor="#e7f6ec", color="#2f7d4f"];
  n_dump [label="dump", fillcolor="#e7f6ec", color="#2f7d4f"];
  n_segments [label="segments", fillcolor="#ffffff", color="#888888"];
  n_segments_ls [label="ls", fillcolor="#f0ead9", color="#9a8a1e"];
  n_segments_verify [label="verify", fillcolor="#f0ead9", color="#9a8a1e"];
  n_scrub [label="scrub", fillcolor="#f0ead9", color="#9a8a1e"];
  n_repair [label="repair", fillcolor="#f0ead9", color="#9a8a1e"];
  n_dlq [label="dlq", fillcolor="#ffffff", color="#888888"];
  n_dlq_ls [label="ls", fillcolor="#e7f6ec", color="#2f7d4f"];
  n_dlq_redrive [label="redrive", fillcolor="#eef3fb", color="#33506b"];
  n_dlq_purge [label="purge", fillcolor="#eef3fb", color="#33506b"];
  n_retention [label="retention", fillcolor="#ffffff", color="#888888"];
  n_retention_info [label="info", fillcolor="#e7f6ec", color="#2f7d4f"];
  n_retention_reap [label="reap", fillcolor="#eef3fb", color="#33506b"];
  n_top [label="top", fillcolor="#e7f6ec", color="#2f7d4f"];
  n_config [label="config", fillcolor="#ffffff", color="#888888"];
  n_config_check [label="check", fillcolor="#f0ead9", color="#9a8a1e"];
  n_config_print [label="print", fillcolor="#f0ead9", color="#9a8a1e"];
  n_config_schema [label="schema", fillcolor="#f0ead9", color="#9a8a1e"];
  n_config_get [label="get", fillcolor="#eef3fb", color="#33506b"];
  n_config_set [label="set", fillcolor="#eef3fb", color="#33506b"];
  n_config_reload [label="reload", fillcolor="#eef3fb", color="#33506b"];
  n_recovery [label="recovery", fillcolor="#ffffff", color="#888888"];
  n_recovery_report [label="report", fillcolor="#f0ead9", color="#9a8a1e"];
  n_version [label="version", fillcolor="#f0ead9", color="#9a8a1e"];
  n_completions [label="completions", fillcolor="#f0ead9", color="#9a8a1e"];
  n_config -> n_config_check;
  n_config -> n_config_get;
  n_config -> n_config_print;
  n_config -> n_config_reload;
  n_config -> n_config_schema;
  n_config -> n_config_set;
  n_consumer -> n_consumer_info;
  n_consumer -> n_consumer_lag;
  n_consumer -> n_consumer_ls;
  n_consumer -> n_consumer_pause;
  n_consumer -> n_consumer_purge;
  n_consumer -> n_consumer_reset;
  n_consumer -> n_consumer_resume;
  n_dlq -> n_dlq_ls;
  n_dlq -> n_dlq_purge;
  n_dlq -> n_dlq_redrive;
  n_recovery -> n_recovery_report;
  n_retention -> n_retention_info;
  n_retention -> n_retention_reap;
  n_segments -> n_segments_ls;
  n_segments -> n_segments_verify;
  root -> n_bench;
  root -> n_completions;
  root -> n_config;
  root -> n_consumer;
  root -> n_dlq;
  root -> n_dump;
  root -> n_info;
  root -> n_peek;
  root -> n_pub;
  root -> n_recovery;
  root -> n_repair;
  root -> n_retention;
  root -> n_scrub;
  root -> n_segments;
  root -> n_serve;
  root -> n_sub;
  root -> n_tap;
  root -> n_top;
  root -> n_version;
  root -> n_wire;
  legend [shape=note, fillcolor="#fbfcff", style=filled, color="#33506b", fontsize=9, label="Global flags: --data-dir, --config, --addr, --json, --log-level.\lOutput: human by default, --json for scripting. Offline commands read the data directory with no server running."];
}
