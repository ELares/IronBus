  }
  subgraph cluster_1 { label="Runtime"; style="rounded,filled"; fillcolor="#e9e3f7"; color="#5a3fa0";
    m_Lease [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#33506b" COLSPAN="2"><FONT COLOR="white"><B>Lease</B>  (runtime)</FONT></TD></TR><TR><TD ALIGN="LEFT">lease_id</TD><TD ALIGN="LEFT">u64 (8)</TD></TR><TR><TD ALIGN="LEFT">consumer</TD><TD ALIGN="LEFT">string (var)</TD></TR><TR><TD ALIGN="LEFT">offset</TD><TD ALIGN="LEFT">u64 (8)</TD></TR><TR><TD ALIGN="LEFT">attempt</TD><TD ALIGN="LEFT">u32 (4)</TD></TR><TR><TD ALIGN="LEFT">granted_unix_ms</TD><TD ALIGN="LEFT">u64 (8)</TD></TR><TR><TD ALIGN="LEFT">visibility_deadline_ms</TD><TD ALIGN="LEFT">u64 (8)</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I>... +1 more</I></TD></TR></TABLE>
