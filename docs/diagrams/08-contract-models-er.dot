    m_ConsumerStateEvent [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#33506b" COLSPAN="2"><FONT COLOR="white"><B>ConsumerStateEvent</B>  (on-disk)</FONT></TD></TR><TR><TD ALIGN="LEFT">event_type</TD><TD ALIGN="LEFT">enum (1)</TD></TR><TR><TD ALIGN="LEFT">offset</TD><TD ALIGN="LEFT">u64 (8)</TD></TR><TR><TD ALIGN="LEFT">attempt</TD><TD ALIGN="LEFT">u32 (4)</TD></TR><TR><TD ALIGN="LEFT">lease_id</TD><TD ALIGN="LEFT">u64 (8)</TD></TR><TR><TD ALIGN="LEFT">fence_token</TD><TD ALIGN="LEFT">u64 (8)</TD></TR><TR><TD ALIGN="LEFT">timestamp_unix_ms</TD><TD ALIGN="LEFT">u64 (8)</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I>... +1 more</I></TD></TR></TABLE>
