// IronBus contract models (generated). Render: dot -Tpdf 08-contract-models-er.dot -o 08-contract-models-er.pdf
digraph contracts {
  rankdir=LR;
  labelloc="t"; fontsize=18; fontname="Helvetica";
  label="IronBus contract models: on-disk, wire, config, runtime, report (fields are the agreed schema, not code)";
  graph [bgcolor="white", ranksep=0.9, nodesep=0.3];
  node [fontname="Helvetica", fontsize=9, shape=plaintext];
  edge [fontname="Helvetica", fontsize=8, color="#555555"];
  subgraph cluster_0 { label="On-disk format"; style="rounded,filled"; fillcolor="#f4f4ef"; color="#9a8a1e";
