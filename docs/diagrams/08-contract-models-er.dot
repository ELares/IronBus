>];
    m_SkipEvent [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#33506b" COLSPAN="2"><FONT COLOR="white"><B>SkipEvent</B>  (report)</FONT></TD></TR><TR><TD ALIGN="LEFT">timestamp</TD><TD ALIGN="LEFT">u64 (8)</TD></TR><TR><TD ALIGN="LEFT">segment_id</TD><TD ALIGN="LEFT">u64 (8)</TD></TR><TR><TD ALIGN="LEFT">reason_code</TD><TD ALIGN="LEFT">enum (1)</TD></TR><TR><TD ALIGN="LEFT">lost_offset_start</TD><TD ALIGN="LEFT">u64 (8)</TD></TR><TR><TD ALIGN="LEFT">lost_offset_end</TD><TD ALIGN="LEFT">u64 (8)</TD></TR><TR><TD ALIGN="LEFT">lost_bytes</TD><TD ALIGN="LEFT">u64 (8)</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I>... +3 more</I></TD></TR></TABLE>
