/target
# `tools/loom-tests` is a separate workspace (#122) with its own build dir; the root `/target` rule
# is anchored to the repo root and does not cover it.
/tools/loom-tests/target
**/*.rs.bk
*.pdb
.DS_Store

# proptest saves a regression seed file on a failing case; this repo runs proptests fresh
# (with a deep nightly sweep) and does not track these transient, machine-generated seeds.
proptest-regressions/
