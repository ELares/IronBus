      ]
    },
    {
      "name": "dedup_duplicate_msg_id_returns_original_offset",
      "category": "dedup",
      "description": "A duplicate msg_id within the window is a benign dedup hit: it returns the ORIGINAL offset with duplicate=true (the DUPLICATE signal code) and appends NO second copy, so the next fresh produce still gets the next sequential offset.",
      "setup": {
        "dedup_max_ids": 8,
        "dedup_window_nanos": 1000
      },
      "steps": [
        {
          "op": "produce_dedup",
          "producer_id": "p1",
          "epoch": 0,
          "msg_id": "m1",
          "payload": "first",
          "outcome": "appended",
          "offset": 0
        },
        {
          "op": "produce_dedup",
          "producer_id": "p1",
          "epoch": 0,
          "msg_id": "m1",
          "payload": "retry",
          "outcome": "duplicate",
          "offset": 0
        },
        {
          "op": "produce_dedup",
          "producer_id": "p1",
          "epoch": 0,
          "msg_id": "m2",
          "payload": "second",
          "outcome": "appended",
          "offset": 1
        }
      ]
    },
    {
      "name": "dedup_evicted_msg_id_is_fresh_again",
      "category": "dedup",
      "description": "An evicted id is fresh: once the count bound evicts the oldest msg_id, a republish of it is treated as a genuinely new produce and gets a NEW offset (at-least-once fallback), never a stale false dedup hit.",
      "setup": {
        "dedup_max_ids": 2,
        "dedup_window_nanos": 0
      },
      "steps": [
        {
          "op": "produce_dedup",
          "producer_id": "p1",
          "epoch": 0,
          "msg_id": "m1",
          "payload": "x",
          "outcome": "appended",
          "offset": 0
        },
        {
          "op": "produce_dedup",
          "producer_id": "p1",
          "epoch": 0,
          "msg_id": "m2",
          "payload": "x",
          "outcome": "appended",
          "offset": 1
        },
        {
          "op": "produce_dedup",
          "producer_id": "p1",
          "epoch": 0,
          "msg_id": "m1",
          "payload": "x",
          "outcome": "duplicate",
          "offset": 0
        },
        {
          "op": "produce_dedup",
          "producer_id": "p1",
          "epoch": 0,
          "msg_id": "m3",
          "payload": "x",
          "outcome": "appended",
          "offset": 2
        },
        {
          "op": "produce_dedup",
          "producer_id": "p1",
          "epoch": 0,
          "msg_id": "m1",
          "payload": "x",
          "outcome": "appended",
          "offset": 3
        }
      ]
    },
    {
      "name": "dedup_stale_producer_epoch_is_fenced",
      "category": "dedup",
      "description": "Epoch fencing: a higher epoch supersedes the old session, and a produce presenting a STALE epoch (below the known high-water) is fenced and rejected with ERR_PRODUCER_FENCED, appending nothing.",
      "setup": {
        "dedup_max_ids": 8,
        "dedup_window_nanos": 0
      },
      "steps": [
        {
          "op": "produce_dedup",
          "producer_id": "p1",
          "epoch": 5,
          "msg_id": "m1",
          "payload": "x",
          "outcome": "appended",
          "offset": 0
        },
        {
          "op": "produce_dedup",
          "producer_id": "p1",
          "epoch": 4,
          "msg_id": "m2",
          "payload": "x",
          "outcome": "fenced"
        }
      ]
    },
    {
      "name": "ack_rejection_cumulative_ack_on_competing_group",
      "category": "ack_rejection",
      "description": "A cumulative ack on a competing (non-broadcast) work-group is hard-rejected with the stable code ERR_CUMULATIVE_ACK_NOT_ALLOWED, and the group's cursor is left untouched.",
      "setup": {},
      "steps": [
        {
          "op": "produce",
          "payload": "a",
          "expect_offset": 0
        },
        {
          "op": "produce",
          "payload": "b",
          "expect_offset": 1
        },
        {
          "op": "poll",
          "group": "workers",
          "now": 0,
          "outcome": "message",
          "expect_offset": 0,
          "bind": "t0"
        },
        {
          "op": "cumulative_ack",
          "group": "workers",
          "up_to": 2,
          "outcome": "error",
          "expect_code": "ERR_CUMULATIVE_ACK_NOT_ALLOWED"
        },
        {
          "op": "expect_committed",
          "group": "workers",
          "offset": 0
        }
      ]
    },
    {
