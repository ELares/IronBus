          "expect_offset": 0
        },
        {
          "op": "produce",
          "payload": "b",
          "expect_offset": 1
        },
        {
          "op": "produce",
          "payload": "c",
          "expect_offset": 2
        },
        {
          "op": "poll",
          "now": 0,
          "outcome": "message",
          "expect_offset": 0,
          "bind": "t0"
        },
        {
          "op": "poll",
          "now": 0,
          "outcome": "message",
          "expect_offset": 1,
          "bind": "t1"
        },
        {
          "op": "poll",
          "now": 0,
          "outcome": "message",
          "expect_offset": 2,
          "bind": "t2"
        },
        {
          "op": "ack",
          "token": "t1",
          "outcome": "acked"
        },
        {
          "op": "expect_committed",
          "offset": 0
        },
        {
          "op": "ack",
          "token": "t2",
          "outcome": "acked"
        },
        {
          "op": "expect_committed",
          "offset": 0
        },
        {
          "op": "ack",
          "token": "t0",
          "outcome": "acked"
        },
        {
          "op": "expect_committed",
          "offset": 3
        }
      ]
    },
    {
      "name": "redelivery_unacked_lease_redelivers_after_expiry",
      "category": "redelivery",
      "description": "At-least-once: an un-acked offset whose lease has expired is redelivered on a later poll with an escalated delivery count and a fresh fencing token; the stale token can no longer ack.",
      "setup": {
        "visibility_nanos": 30
      },
      "steps": [
        {
          "op": "produce",
          "payload": "a",
          "expect_offset": 0
        },
        {
          "op": "poll",
          "now": 0,
          "outcome": "message",
          "expect_offset": 0,
          "expect_deliveries": 1,
          "bind": "first"
        },
        {
          "op": "poll",
          "now": 10,
          "outcome": "idle"
        },
        {
          "op": "poll",
          "now": 40,
          "outcome": "message",
          "expect_offset": 0,
          "expect_deliveries": 2,
          "bind": "second"
        },
        {
          "op": "ack",
          "token": "first",
          "outcome": "not_owned"
        },
        {
          "op": "ack",
          "token": "second",
          "outcome": "acked"
        },
        {
          "op": "expect_committed",
          "offset": 1
        }
      ]
    },
    {
      "name": "redelivery_acked_message_is_not_redelivered",
      "category": "redelivery",
