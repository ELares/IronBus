    {
      "name": "broadcast_group_of_one_rejects_a_second_subscriber",
      "category": "broadcast",
      "description": "The broadcast group-of-one invariant: a first subscriber attaches, but a SECOND distinct subscriber is rejected with ERR_BROADCAST_GROUP_BUSY (so a cumulative ack can only ever commit past the lone consumer's own work).",
      "setup": {},
      "steps": [
        {
          "op": "set_broadcast",
          "group": "bcast",
          "broadcast": true
        },
        {
          "op": "subscribe",
          "group": "bcast",
          "member": 1
        },
        {
          "op": "subscribe",
          "group": "bcast",
          "member": 2,
          "expect_code": "ERR_BROADCAST_GROUP_BUSY"
        }
      ]
    },
    {
      "name": "trim_below_horizon_read_returns_offset_trimmed",
      "category": "trim",
      "description": "A read of a trimmed offset returns OFFSET_TRIMMED: under the drop-oldest disk-full policy a stuck consumer's records are force-reaped, so its next poll is a one-time truncation that resets its cursor up to the earliest retained offset and reports the skipped span; the SAME gap never re-truncates.",
      "setup": {
        "max_total_bytes": 256,
        "max_segment_bytes": 160,
        "disk_full_policy": "drop_oldest",
        "visibility_nanos": 30
      },
      "steps": [
        {
          "op": "produce",
          "payload": "0123456789abcdef",
          "expect_offset": 0
        },
        {
          "op": "poll",
          "group": "stuck",
          "now": 0,
          "outcome": "message",
          "expect_offset": 0,
          "bind": "s0"
        },
        {
          "op": "produce",
          "payload": "0123456789abcdef",
          "expect_offset": 1
        },
        {
          "op": "produce",
          "payload": "0123456789abcdef",
          "expect_offset": 2
        },
        {
          "op": "produce",
          "payload": "0123456789abcdef",
          "expect_offset": 3
        },
        {
          "op": "produce",
          "payload": "0123456789abcdef",
          "expect_offset": 4
