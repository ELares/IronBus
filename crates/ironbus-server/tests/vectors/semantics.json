          "op": "expect_committed",
          "group": "bcast",
          "offset": 0
        }
      ]
    },
    {
      "name": "key_routing_per_key_head_of_line_one_member",
      "category": "key_routing",
      "description": "Per-key head-of-line order: with a single key-shared member, two records sharing a key are delivered strictly in order; the second is withheld (the key is busy) until the first drains, then delivers. Hash-independent because one member owns every key.",
      "setup": {
        "max_in_flight": 16
      },
      "steps": [
        {
          "op": "set_key_ordering",
          "group": "ks",
          "ordering": "key_shared"
        },
        {
          "op": "join_member",
          "group": "ks",
          "member": 1
        },
        {
          "op": "produce",
          "key": "alpha",
          "payload": "a0",
          "expect_offset": 0
        },
        {
          "op": "produce",
          "key": "alpha",
          "payload": "a1",
          "expect_offset": 1
        },
        {
          "op": "poll",
          "group": "ks",
          "now": 0,
          "member": 1,
          "outcome": "message",
          "expect_offset": 0,
          "expect_key": "alpha",
          "bind": "a0"
        },
        {
          "op": "poll",
          "group": "ks",
          "now": 0,
          "member": 1,
          "outcome": "idle"
        },
        {
          "op": "ack",
          "group": "ks",
          "token": "a0",
          "outcome": "acked"
        },
        {
          "op": "poll",
          "group": "ks",
          "now": 0,
          "member": 1,
          "outcome": "message",
          "expect_offset": 1,
          "expect_key": "alpha",
          "bind": "a1"
        },
        {
          "op": "ack",
          "group": "ks",
          "token": "a1",
          "outcome": "acked"
        },
        {
          "op": "expect_committed",
          "group": "ks",
          "offset": 2
        }
      ]
    },
    {
      "name": "key_routing_distinct_keys_do_not_block_each_other",
      "category": "key_routing",
      "description": "Head-of-line is PER KEY, not global: two records on DIFFERENT keys are both deliverable to the member at once (one busy key does not stall an unrelated key).",
      "setup": {
        "max_in_flight": 16
      },
      "steps": [
        {
          "op": "set_key_ordering",
          "group": "ks",
          "ordering": "key_shared"
        },
        {
          "op": "join_member",
          "group": "ks",
          "member": 1
        },
        {
          "op": "produce",
          "key": "alpha",
          "payload": "a0",
          "expect_offset": 0
        },
        {
          "op": "produce",
          "key": "beta",
          "payload": "b0",
          "expect_offset": 1
        },
        {
          "op": "poll",
          "group": "ks",
          "now": 0,
          "member": 1,
          "outcome": "message",
          "expect_offset": 0,
          "expect_key": "alpha",
          "bind": "a0"
        },
        {
          "op": "poll",
          "group": "ks",
          "now": 0,
          "member": 1,
          "outcome": "message",
          "expect_offset": 1,
          "expect_key": "beta",
          "bind": "b0"
        },
        {
          "op": "ack",
          "group": "ks",
          "token": "a0",
          "outcome": "acked"
        },
        {
          "op": "ack",
          "group": "ks",
          "token": "b0",
          "outcome": "acked"
        },
        {
          "op": "expect_committed",
          "group": "ks",
          "offset": 2
        }
      ]
    },
    {
      "name": "broadcast_cursors_are_independent_per_group",
      "category": "broadcast",
      "description": "Each consumer group has its own committed cursor over the shared log: two broadcast groups read the same records and advance independently; committing one's cursor does not move the other's.",
      "setup": {},
      "steps": [
        {
          "op": "set_broadcast",
          "group": "g1",
          "broadcast": true
        },
        {
          "op": "set_broadcast",
          "group": "g2",
          "broadcast": true
        },
        {
          "op": "produce",
          "payload": "a",
          "expect_offset": 0
        },
        {
          "op": "produce",
          "payload": "b",
          "expect_offset": 1
        },
        {
          "op": "produce",
          "payload": "c",
          "expect_offset": 2
        },
        {
          "op": "poll",
          "group": "g1",
          "now": 0,
          "outcome": "message",
          "expect_offset": 0,
          "bind": "g1_0"
        },
        {
          "op": "ack",
          "group": "g1",
          "token": "g1_0",
          "outcome": "acked"
        },
        {
          "op": "poll",
          "group": "g1",
          "now": 0,
          "outcome": "message",
          "expect_offset": 1,
          "bind": "g1_1"
        },
        {
          "op": "ack",
          "group": "g1",
          "token": "g1_1",
          "outcome": "acked"
        },
        {
          "op": "expect_committed",
          "group": "g1",
          "offset": 2
        },
        {
          "op": "expect_committed",
          "group": "g2",
          "offset": 0
        },
        {
          "op": "poll",
          "group": "g2",
          "now": 0,
          "outcome": "message",
          "expect_offset": 0,
          "bind": "g2_0"
