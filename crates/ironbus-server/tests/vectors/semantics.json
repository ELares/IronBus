      "steps": [
        {
          "op": "produce",
          "payload": "a",
          "expect_offset": 0
        },
        {
          "op": "poll",
          "now": 0,
          "outcome": "message",
          "expect_offset": 0,
          "bind": "t0"
        },
        {
          "op": "ack",
          "token": "t0",
          "outcome": "acked"
        },
        {
          "op": "poll",
          "now": 100,
          "outcome": "idle"
        },
        {
          "op": "expect_committed",
          "offset": 1
        }
      ]
    },
    {
      "name": "redelivery_nack_requeues_with_escalated_delivery_count",
      "category": "redelivery",
      "description": "A nack requeues the message for an immediate redelivery, which arrives with an escalated delivery count.",
      "setup": {},
