    {
      "name": "broadcast_cumulative_ack_advances_single_cursor",
      "category": "broadcast",
      "description": "A broadcast group accepts the cumulative-ack verb: committing up_to (exclusive) jumps its single cursor to that offset in one move, and an idempotent re-ack at or below the commit is a no-op success that never regresses the watermark.",
      "setup": {},
      "steps": [
        {
          "op": "set_broadcast",
          "group": "bcast",
          "broadcast": true
        },
        {
          "op": "produce",
          "payload": "a",
          "expect_offset": 0
        },
        {
          "op": "produce",
          "payload": "b",
          "expect_offset": 1
        },
        {
          "op": "produce",
          "payload": "c",
          "expect_offset": 2
        },
        {
          "op": "cumulative_ack",
          "group": "bcast",
