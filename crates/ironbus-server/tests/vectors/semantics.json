      "setup": {
        "visibility_nanos": 30
      },
      "steps": [
        {
          "op": "produce",
          "payload": "a",
          "expect_offset": 0
        },
        {
          "op": "poll",
          "now": 0,
          "outcome": "message",
          "expect_offset": 0,
          "bind": "stale"
        },
        {
          "op": "poll",
          "now": 40,
          "outcome": "message",
          "expect_offset": 0,
          "expect_deliveries": 2,
          "bind": "live"
        },
        {
          "op": "ack",
          "token": "stale",
          "outcome": "not_owned"
        },
        {
          "op": "ack",
          "token": "live",
          "outcome": "acked"
        },
        {
          "op": "expect_committed",
          "offset": 1
        }
      ]
    },
    {
