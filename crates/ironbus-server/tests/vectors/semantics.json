{
  "description": "IronBus SEMANTICS conformance vectors (#35). Language-agnostic input-sequence -> observable-output vectors that pin every observable behavior the parent #3 contract promises. Each vector is a name, a category, an engine setup, and an ordered list of input operations with their expected observable outputs (offsets, redeliveries, stable error codes, cursor positions, dedup flags, trim signals). Time flows ONLY through an injected logical clock (each poll carries an explicit monotonic `now` in nanoseconds), so leases, dedup windows, and trims are driven by advancing logical time with NO real sleeps; the suite is deterministic. The stable error codes (ERR_CUMULATIVE_ACK_NOT_ALLOWED, ERR_ACK_NOT_OWNED, OFFSET_TRIMMED, ERR_PRODUCER_FENCED, ...) are the frozen taxonomy in ironbus_server::codes::ErrorCode and are asserted against here. The Rust harness in conformance_vectors.rs runs these against the REAL engine; an external client harness can drive the same vectors over the wire.",
  "vectors": [
    {
      "name": "ordering_monotonic_offsets_no_gaps",
      "category": "ordering",
      "description": "A producer sends N records; the assigned offsets are 0..N-1 in exact order with no gaps, and a broadcast (group-of-one) consumer reads them back in that exact order.",
      "setup": {},
      "steps": [
        {
          "op": "produce",
          "payload": "a",
          "expect_offset": 0
        },
        {
          "op": "produce",
          "payload": "b",
          "expect_offset": 1
        },
        {
          "op": "produce",
          "payload": "c",
          "expect_offset": 2
        },
        {
          "op": "produce",
          "payload": "d",
          "expect_offset": 3
        },
        {
          "op": "poll",
          "now": 0,
          "outcome": "message",
          "expect_offset": 0,
          "expect_deliveries": 1,
          "bind": "t0"
        },
        {
          "op": "ack",
          "token": "t0",
          "outcome": "acked"
        },
        {
          "op": "poll",
          "now": 0,
          "outcome": "message",
          "expect_offset": 1,
          "expect_deliveries": 1,
          "bind": "t1"
        },
        {
          "op": "ack",
          "token": "t1",
          "outcome": "acked"
        },
        {
          "op": "poll",
          "now": 0,
          "outcome": "message",
          "expect_offset": 2,
          "expect_deliveries": 1,
          "bind": "t2"
        },
        {
          "op": "ack",
          "token": "t2",
          "outcome": "acked"
        },
        {
          "op": "poll",
          "now": 0,
          "outcome": "message",
          "expect_offset": 3,
          "expect_deliveries": 1,
          "bind": "t3"
        },
        {
          "op": "ack",
          "token": "t3",
          "outcome": "acked"
        },
        {
          "op": "poll",
          "now": 0,
          "outcome": "idle"
        },
        {
          "op": "expect_committed",
          "offset": 4
        }
      ]
    },
    {
      "name": "ordering_out_of_order_ack_only_advances_contiguous_prefix",
      "category": "ordering",
      "description": "The committed cursor advances only over the contiguous acked prefix: acking offset 1 and 2 before 0 leaves the cursor at 0; acking 0 then jumps it to 3.",
      "setup": {},
      "steps": [
