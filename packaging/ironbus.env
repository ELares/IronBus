# SPDX-License-Identifier: MIT OR Apache-2.0
#
# Default IronBus broker configuration, installed by the .deb at /etc/ironbus/ironbus.env and read
# by the systemd unit's EnvironmentFile. Every `serve` flag has an IRONBUS_<FLAG> env var (the flag
# name uppercased, dashes to underscores); precedence is flag > env > compiled default. See
# docs/CLI.md for the full list and docs/EDGE_TUNING.md for the edge defaults.
#
# This file is a dpkg conffile: local edits are preserved across package upgrades.

# The durable WAL / segment directory. MUST be on a writable, persistent filesystem; in the
# container this is the required volume mount (see docs/DISTRIBUTION.md).
IRONBUS_DATA_DIR=/var/lib/ironbus

# The bind address. Loopback only by default so a zero-config broker is never exposed off-host
# without a deliberate choice. Set to 0.0.0.0:7777 (and configure auth/TLS, #106/#107) to expose it.
IRONBUS_ADDR=127.0.0.1:7777

# A few commonly-tuned edge knobs, shown at their compiled defaults (uncomment to change):
# IRONBUS_MAX_CONNECTIONS=256
# IRONBUS_MAX_SEGMENT_BYTES=67108864
# IRONBUS_MAX_TOTAL_BYTES=0
# IRONBUS_VISIBILITY_TIMEOUT_MS=30000
# IRONBUS_MAX_DELIVER=5

# The systemd unit's readiness grace window (seconds) before a start is counted as successful and the
# fall-back failure budget is cleared (ExecStartPost). A binary that crashes within this window is a
# failed start and is NOT cleared; one that stays up past it resets the budget. Keep it shorter than a
# real first-boot mount/init time but long enough that a genuinely broken binary has crashed by then.
# IRONBUS_STARTUP_GRACE_SEC=10
